<resources>
    <!--
        The whole UI is drawn with Jetpack Compose (see ui/theme/Theme.kt).
        This XML theme only styles the window before Compose starts.
        AppCompat is the parent because AppCompatActivity is needed for
        per-app language switching on Android 12 and lower.
    -->
    <style name="Theme.JordanTouristGuide" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
